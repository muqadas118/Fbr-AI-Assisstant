# Frontend environment configuration.
# Copy to .env.local and adjust for your environment.
# No secrets live here. Never commit a real .env.local.

# URL of the FastAPI backend (Phase 10 API).
# Default is the local development server; change for staging/production.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Default request timeout (ms) for API calls.
VITE_API_TIMEOUT_MS=30000
