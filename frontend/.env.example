# Frontend environment configuration.
# Copy to .env.local and adjust for your environment.
# No secrets live here. Never commit a real .env.local.

# URL of the FastAPI backend (Phase 10 API).
# Default is the local development server; change for staging/production.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Default request timeout (ms) for API calls.
VITE_API_TIMEOUT_MS=30000

# Supabase Auth (frontend). Fill these from the Supabase dashboard
# (Project Settings -> API) into your local .env / .env.local.
# No secrets are committed here — placeholders only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# OAuth / magic-link redirect back into the SPA.
VITE_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
