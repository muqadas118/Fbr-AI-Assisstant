# FBR AI Assistant - environment configuration template
#
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file or share real API keys.

# Primary LLM provider (Groq) - https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Fallback LLM provider (OpenRouter) - https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# =============================================================================
# Application
# =============================================================================
APP_NAME="FBR AI Tax Assistant"
APP_VERSION="1.0.0"
APP_ENV=development  # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Security (REQUIRED in production)
# =============================================================================
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# Supabase Auth (user authentication + Google OAuth)
# =============================================================================
# Create a project at https://supabase.com, then copy values from:
#   Settings → API → Project URL      → SUPABASE_URL
#   Settings → API → anon public key  → SUPABASE_ANON_KEY
#   Settings → API → JWT secret         → SUPABASE_JWT_SECRET
#
# To enable Google OAuth:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (Web application)
#   3. Add authorized redirect URI from Supabase:
#      https://your-project.supabase.co/auth/v1/callback
#   4. In Supabase Dashboard → Authentication → Providers → Google:
#      Client ID     = your Google OAuth Client ID
#      Client Secret = your Google OAuth Client Secret
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...your-anon-public-key...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# Gate POST /answer and POST /calculate behind a valid Supabase bearer token.
# Leave as `true` for anything reachable from a network. Set to `false` ONLY for
# local development, before the frontend login flow lands; the server logs a
# warning on every startup and reports {"auth": "disabled"} on GET /health so
# a fail-open deployment cannot go unnoticed.
FBR_AUTH_REQUIRED=true

# =============================================================================
# Docker Compose service credentials (used by docker-compose.yml)
# =============================================================================
POSTGRES_USER=fbr
POSTGRES_PASSWORD=
POSTGRES_DB=fbr_assistant
GRAFANA_ADMIN_PASSWORD=

# =============================================================================
# Database
# =============================================================================
# SQLite (development)
DATABASE_URL=sqlite:///./fbr_assistant.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/fbr_assistant

# =============================================================================
# Redis (optional, for session/cache)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# FBR API Integration
# =============================================================================
FBR_API_KEY=
FBR_API_BASE_URL=https://gw.fbr.gov.pk
FBR_API_TIMEOUT=30

# NTN / business verification source. Default `off` means the verification
# endpoints return an explicit "unavailable" result. They must NEVER return a
# generated taxpayer name — see app/common/unavailable.py.
#   off  = no lookup, return Unavailable          (default, always safe)
#   atl  = FBR public Active Taxpayer List        (filer status only, no name)
#   iris = FBR IRIS/PRAL API                      (requires FBR_API_KEY)
FBR_VERIFICATION_MODE=off

# =============================================================================
# Email (for notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@fbr-assistant.pk

# =============================================================================
# SMS (optional)
# =============================================================================
# SMS_PROVIDER=twilio
# SMS_API_KEY=

# =============================================================================
# Monitoring
# =============================================================================
ENABLE_METRICS=true
SENTRY_DSN=
# SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/1234567

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_AI_FEATURES=true
ENABLE_PDF_PROCESSING=true
ENABLE_OCR=true
ENABLE_NOTIFICATIONS=true
