# Copy to .env and fill in your keys.
# The backend reads this file at startup (python-dotenv).

# --- LLM providers ---
# Primary provider for grounded RAG answers.
GROQ_API_KEY=

# Fallback provider (used when Groq is unavailable).
OPENROUTER_API_KEY=

# --- Supabase (optional) ---
# Enables the Supabase JWT dual-path auth and email confirmation.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Reject unconfirmed emails on the Supabase path (default true).
SUPABASE_REQUIRE_EMAIL_CONFIRM=true

# --- Auth policy ---
# true (default): protected endpoints require a bearer token.
# false: local-develop-only fail-open mode.
FBR_AUTH_REQUIRED=true

# --- Account persistence ---
# Path to the JSON store that holds accounts (default data/auth_users.json).
FBR_AUTH_STORE=data/auth_users.json

# --- CORS ---
# Comma-separated frontend origins allowed to call the API.
# Defaults to localhost:5173 / 127.0.0.1:5173 dev origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174