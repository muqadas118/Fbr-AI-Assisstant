# Copy to .env and fill in your keys.
# The backend reads this file at startup (python-dotenv).

# --- LLM providers ---
# Ordered provider chain (app/llm.py). Names are comma-separated and tried
# left to right; on 429 / 5xx / network error / empty content the next one is
# used. Each name maps to LLM_<NAME>_BASE_URL + LLM_<NAME>_MODEL (+ optional
# LLM_<NAME>_API_KEY). Any OpenAI-compatible endpoint works (Gemini
# OpenAI-compat, Cerebras, Mistral, DeepSeek, Together, Fireworks,
# AgentRouter, local Ollama / LM Studio / vLLM, ...).
# LLM_PROVIDERS=gemini,groq,cerebras,openrouter,local

# Example provider set — Gemini (replace the angle-bracket placeholders).
# LLM_GEMINI_BASE_URL=https://<your-gemini-openai-compatible-endpoint>/v1
# LLM_GEMINI_MODEL=<gemini-model-id>
# LLM_GEMINI_API_KEY=<your-key>

# Example provider set — Cerebras.
# LLM_CEREBRAS_BASE_URL=https://<your-cerebras-openai-compatible-endpoint>/v1
# LLM_CEREBRAS_MODEL=<cerebras-model-id>
# LLM_CEREBRAS_API_KEY=<your-key>

# Legacy aliases (mapped into the chain automatically; kept for compatibility).
# Primary provider for grounded RAG answers.
GROQ_API_KEY=

# Fallback provider (used when Groq is unavailable).
OPENROUTER_API_KEY=

# --- Supabase (optional) ---
# Enables the Supabase JWT dual-path auth and email confirmation.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Reject unconfirmed emails on the Supabase path (default true).
SUPABASE_REQUIRE_EMAIL_CONFIRM=true

# --- Auth policy ---
# true (default): protected endpoints require a bearer token.
# false: local-develop-only fail-open mode.
FBR_AUTH_REQUIRED=true

# --- Application secrets ---
# app/deployment/config.py defaults SECRET_KEY to "change-me-in-production"
# and flags that value as a production issue. Generate a real one, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-generated-secret-key

# --- Sessions ---
# Account/session lifetime in hours (default 24; app/multi_user/auth.py).
FBR_SESSION_TTL_HOURS=24

# --- Team store (app/multi_user/team.py) ---
# JSON store for teams, memberships and invitations (default data/auth_teams.json).
FBR_TEAM_STORE=data/auth_teams.json

# --- Self-learning / personalization (app/learning, app/routers/personalization.py) ---
# SQLite store for per-user behavioural signals (default data/learning.db).
FBR_LEARNING_DB=data/learning.db
# Global on/off switch for the learning module (default on).
FBR_LEARNING_ENABLED=1
# Store the raw question text too (default 0 = derived signals only).
FBR_LEARNING_STORE_RAW_QUERIES=0
# Days of per-user interaction history kept (default 90).
FBR_LEARNING_RETENTION_DAYS=90
# Personalization endpoint rate limits (<requests>/<seconds>).
# GET /personalization/profile (default 60/60).
FBR_LEARNING_PROFILE_RATE_LIMIT=60/60
# POST /personalization/feedback (default 30/60).
FBR_LEARNING_FEEDBACK_RATE_LIMIT=30/60

# --- Rate limits (app/common/rate_limit.py: <requests>/<seconds>) ---
# /assistant/ask and other LLM endpoints (default 10 per 60s).
ASSISTANT_RATE_LIMIT=10/60
# Team invite/accept endpoints (default 10 per 60s).
TEAM_AUTH_RATE_LIMIT=10/60

# --- Daily per-account quota (app/quotas.py, app/routers/quota.py) ---
# Per-account budget of assistant messages and chat file uploads that resets
# at local midnight in FBR_QUOTA_TIMEZONE. GET /quota returns the snapshot.
# Global on/off switch (default on).
FBR_QUOTA_ENABLED=1
# Assistant messages per account per day (default 10). 0 blocks immediately;
# a negative value means unlimited.
FBR_DAILY_MESSAGE_LIMIT=10
# File uploads per account per day, shared across the upload routes
# (default 5). 0 blocks immediately; a negative value means unlimited.
FBR_DAILY_UPLOAD_LIMIT=5
# SQLite path for the usage counters (default data/usage.db).
FBR_QUOTA_DB=data/usage.db
# IANA timezone for the local-midnight reset boundary (default Asia/Karachi).
FBR_QUOTA_TIMEZONE=Asia/Karachi
# Behaviour on a quota-store error: 1 (default) fails open (requests allowed,
# usage unmetered); 0 fails closed (requests rejected with 429).
FBR_QUOTA_FAIL_OPEN=1

# --- Retrieval / vectorstore (app/hybrid_retriever.py) ---
# Leave unset to use the project defaults; override to point at another index.
FBR_VECTORSTORE_INDEX=data/profile/vectorstore/fbr_faiss.index
FBR_VECTORSTORE_METADATA=data/profile/vectorstore/metadata.json
FBR_CHUNKS_PATH=data/profile/source_docs/chunks/chunks.json
FBR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Answer grounding (app/rag_engine.py) ---
# Minimum semantic similarity for a single chunk to count as evidence (default 0.20).
FBR_MIN_SEMANTIC_EVIDENCE_SCORE=0.20

# --- Monitoring / metrics (app/api.py, app/deployment/metrics.py) ---
# Set to true to expose GET /metrics in Prometheus text format (default off).
FBR_METRICS_ENABLED=false

# --- FBR monitor (app/fbr_monitor, app/routers/monitor.py) ---
# Development-only switches. All default to off; enable them one at a time
# for local testing and never in production.
# Allow the simulated-notice route.
FBR_MONITOR_ALLOW_SIMULATE=0
# Skip the real webhook HTTP POST and record a simulated delivery instead.
FBR_MONITOR_SIMULATE_DELIVERY=0
# Permit plain-HTTP (non-localhost) webhook targets for local testing.
FBR_MONITOR_ALLOW_INSECURE_WEBHOOK=0

# --- Simulated providers (offline/dev only) ---
# Force the OCR engine to its simulated implementation (app/document_intelligence/ocr.py).
FBR_OCR_SIMULATE=0
# Re-enable the verification-center simulated verifiers (app/verification_center/api.py).
FBR_VERIFICATION_SIMULATE=0

# --- docker-compose services (required by docker-compose.yml) ---
# POSTGRES_DB defaults to fbr_assistant when unset.
POSTGRES_USER=fbr
POSTGRES_PASSWORD=replace-with-generated-db-password
GRAFANA_ADMIN_PASSWORD=replace-with-generated-grafana-password

# --- Account persistence ---
# Path to the JSON store that holds accounts (default data/auth_users.json).
FBR_AUTH_STORE=data/auth_users.json

# --- CORS ---
# Comma-separated frontend origins allowed to call the API.
# Defaults to localhost:5173 / 127.0.0.1:5173 dev origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
